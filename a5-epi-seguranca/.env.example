# Ambiente do backend A5
A5_ENV=development
A5_LOG_LEVEL=INFO

# Quando os componentes reais existirem, trocar para "real" liga os clientes de
# verdade (a implementar); por enquanto só "mock" existe.
A5_I9_CLIENT=mock
A5_S2_CLIENT=mock
A5_S3_CLIENT=mock
A5_S4_CLIENT=mock

# Faixa de confiança intermediária (RNF2 / RF-orquestração de incerteza)
A5_CONFIANCA_MINIMA=0.4
A5_CONFIANCA_MAXIMA=0.8

# Login (RF9). Com true, toda rota exige token Bearer; com false, chamadas sem token
# ainda funcionam (usuário/papel no corpo). Em development nascem operador, supervisor,
# auditor (senha <papel>123) e administrador (senha abaixo, padrão admin123).
A5_EXIGIR_LOGIN=false
A5_ADMIN_SENHA=
